diff --git a/source/test/incrementalFrames.test.js b/source/test/incrementalFrames.test.js
new file mode 100644
index 0000000..38be9bc
--- /dev/null
+++ b/source/test/incrementalFrames.test.js
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {demoFeed,createSampler,validateFeed} from '../src/adapter.js';
+import {ViewerController} from '../src/viewer/ViewerController.js';
+
+test('reached frames append without replacing the camera or scene',()=>{
+  const source=demoFeed(30);
+  const initial={...source,streaming:true,events:[],
+    frames:[source.frames[0],
+      {time:source.duration,positions:[]}]};
+  validateFeed(initial);
+  const controller=Object.create(ViewerController.prototype);
+  const camera={type:'rider',id:source.riders[0].id};
+  Object.assign(controller,{feed:initial,
+    sample:createSampler(initial),sceneRevision:0,
+    cameraSettled:true,target:camera,disposed:false});
+  assert.deepEqual(controller.sample(0).positions.length,30);
+  assert.equal(controller.appendRecordedFrames([source.frames[1]]),
+    source.frames[1].time);
+  assert.equal(controller.sample(source.frames[1].time)
+    .positions.length,30);
+  assert.equal(controller.sceneRevision,1);
+  assert.equal(controller.target,camera);
+  assert.deepEqual(controller.feed.frames.at(-1).positions,[]);
+  assert.throws(()=>controller.appendRecordedFrames(
+    [source.frames[1]]),/advance in source order/);
+  assert.equal(controller.appendRecordedFrames(
+    source.frames.slice(2)),source.duration);
+  assert.deepEqual(controller.feed.frames,source.frames);
+  assert.throws(()=>controller.appendRecordedFrames(
+    [source.frames.at(-1)]),/advance in source order/);
+});
