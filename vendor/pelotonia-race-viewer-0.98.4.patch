diff --git a/source/test/crowdAutoFinish.test.js b/source/test/crowdAutoFinish.test.js
new file mode 100644
index 0000000..5271b7c
--- /dev/null
+++ b/source/test/crowdAutoFinish.test.js
@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {roadsidePeople} from '../src/viewer/roadside.js';
+import {createRoute} from '../src/viewer/geometry.js';
+import {validateFeed} from '../src/adapter.js';
+import {conditionsDemo} from '../src/demoConditions.js';
+
+test('explicit sparse finish crowd replaces the automatic dense zone',()=>{
+  const route=createRoute([[0,0,0],[0,0,1000]]);
+  const feed={route:{width:7,surfaces:[]},
+    finish:{routeFraction:1},
+    crowd:{enabled:true,backgroundSpacing:80,
+      zones:[{id:'finish-study',from:700,to:1000,
+        kind:'finish',rows:1,spacing:8}]}};
+  const dense=roadsidePeople(feed,route,900);
+  const sparseFeed={...feed,crowd:{...feed.crowd,autoFinish:false}};
+  const sparse=roadsidePeople(sparseFeed,route,900);
+  assert.ok(dense.length>sparse.length*2);
+  assert.ok(sparse.length>0);
+  assert.deepEqual(sparse,roadsidePeople(sparseFeed,route,900));
+});
+
+test('automatic finish setting accepts only booleans',()=>{
+  const feed=conditionsDemo('rain-cobbles');
+  feed.crowd.autoFinish=false;
+  assert.equal(validateFeed(feed),feed);
+  feed.crowd.autoFinish='false';
+  assert.throws(()=>validateFeed(feed),/Invalid viewer feed/);
+});
